{
	email {$SR_ACME_EMAIL}
}

{$SR_DOMAIN} {
	encode zstd gzip

	# سقف حجم درخواست: کمی بالاتر از MAX_UPLOAD_BYTES تا هدرهای multipart جا شوند.
	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# گیت‌وی realtime — وب‌سوکت
	handle /ws* {
		reverse_proxy gateway:4001
	}

	# سلامت گیت‌وی برای اسکریپت health.sh
	handle /gateway-health {
		reverse_proxy gateway:4001
	}

	# سیگنالینگ LiveKit؛ خود مدیا روی UDP جدا می‌رود.
	handle_path /rtc* {
		reverse_proxy host.docker.internal:7880
	}

	# پیوست‌ها: بدنه‌ی بزرگ و پاسخ طولانی، بدون فشرده‌سازی دوباره
	handle /api/files/* {
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}

	handle /api/uploads* {
		reverse_proxy web:3000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# بقیه‌ی ترافیک → اپ Next.js
	handle {
		reverse_proxy web:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
