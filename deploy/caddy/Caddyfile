{
	email {$SR_ACME_EMAIL}
}

{$SR_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# گیت‌وی realtime — وب‌سوکت
	handle /ws* {
		reverse_proxy gateway:4001
	}

	# سلامت گیت‌وی برای اسکریپت health.sh
	handle /gateway-health {
		reverse_proxy gateway:4001
	}

	# سیگنالینگ LiveKit؛ خود مدیا روی UDP جدا می‌رود.
	handle_path /rtc* {
		reverse_proxy host.docker.internal:7880
	}

	# بقیه‌ی ترافیک → اپ Next.js
	handle {
		reverse_proxy web:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
