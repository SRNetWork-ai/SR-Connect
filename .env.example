# ─────────────────────────────────────────────────────────────────────────────
#  SR-Connect — نمونهٔ تنظیمات
#
#  برای سرور : کپی کن به  deploy/.env   (نصب‌کنندهٔ خودکار خودش می‌سازدش)
#  برای توسعه: کپی کن به  .env
#
#  هرگز فایل واقعی .env را کامیت نکن. همهٔ CHANGE_ME ها باید عوض شوند.
# ─────────────────────────────────────────────────────────────────────────────

# ── دامنه و TLS (فقط برای docker compose) ────────────────────────────────────
SR_DOMAIN=chat.example.com
SR_ACME_EMAIL=you@example.com
SR_VERSION=1.0.0

# ── دیتابیس ──────────────────────────────────────────────────────────────────
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://sr:CHANGE_ME@postgres:5432/srconnect
# برای توسعهٔ محلی بدون داکر:
# DATABASE_URL=postgres://sr:sr@localhost:5432/srconnect
# اگر این متغیر خالی بماند، برنامه در «حالت دمو» (in-memory) بالا می‌آید.

# ── LiveKit (صدا) ────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=CHANGE_ME              # مثلا API1a2b3c4d5e6f
LIVEKIT_API_SECRET=CHANGE_ME           # openssl rand -hex 32
LIVEKIT_URL=ws://livekit:7880          # آدرس داخلی برای سرور
LIVEKIT_PUBLIC_URL=                    # خالی = /livekit روی همان دامنه

# ── TURN / STUN ──────────────────────────────────────────────────────────────
TURN_SECRET=CHANGE_ME                  # openssl rand -hex 24

# ── Gateway (WebSocket) ──────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787
GATEWAY_TRUST_PROXY=1
NEXT_PUBLIC_GATEWAY_URL=               # خالی = /ws روی همان دامنه

# ── سیستم آپدیت ──────────────────────────────────────────────────────────────
#   تولید کلید:  npm run keygen -- deploy/keys
#   UPDATE_SIGNING_KEY = base64 از فایل PEM خصوصی  (base64 -w0 update-signing.key)
#   UPDATE_PUBKEY      = محتوای update-signing.pub (base64 خام ۳۲ بایتی)
UPDATE_SIGNING_KEY=CHANGE_ME           # فقط روی سرور یا در GitHub Secrets
UPDATE_PUBKEY=CHANGE_ME
NEXT_PUBLIC_UPDATE_PUBKEY=CHANGE_ME    # همان UPDATE_PUBKEY
NEXT_PUBLIC_UPDATE_CHANNEL=stable
UPDATE_CHANNEL=stable
UPDATE_MANDATORY=0
MIN_CLIENT_VERSION=0.0.0
RELEASES_DIR=/app/releases

# ── نشست و ثبت‌نام ───────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
ALLOW_REGISTRATION=1                   # 0 = ثبت‌نام عمومی بسته
REQUIRE_INVITE=0                       # 1 = فقط با کد دعوت

# ── ادمین اولیه (فقط هنگام seed خوانده می‌شود) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_DISPLAY_NAME=مدیر
ADMIN_EMAIL=

# ── ظرفیت و نمایش ────────────────────────────────────────────────────────────
VOICE_CAPACITY=20
SERVER_REGION=ir
NEXT_PUBLIC_SERVER_URL=
NEXT_PUBLIC_REDUCE_MOTION=0

# ── نسخه ─────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_VERSION=3

NODE_ENV=production
